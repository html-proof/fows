# --- Serving ---
# Directory holding mf_model.npz + metadata.json produced by train.py.
# If it is empty the service still boots and serves heuristic scores.
MODEL_DIR=artifacts
# Shared secret the Node gateway sends as the X-API-Key header.
# Without it, only localhost callers are accepted.
ML_SERVICE_API_KEY=replace-with-strong-random

# --- Training only (not needed on the Render web service) ---
TRAIN_DATA_PATH=data/interactions.csv
EPOCHS=12
BATCH_SIZE=256
EMBEDDING_DIM=32
LEARNING_RATE=0.05
REGULARIZATION=0.02
