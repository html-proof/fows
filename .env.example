# Keepalive worker variables
KEEPALIVE_URL=https://your-service-name.onrender.com
KEEPALIVE_INTERVAL_MS=240000
KEEPALIVE_TIMEOUT_MS=10000
CORS_ORIGINS=https://your-frontend.example.com

# ── Region configuration ──────────────────────────────────────────────────────
# These are three distinct concepts and must never be combined into one variable.

# AWS deployment region — infrastructure location only, has no effect on catalogs.
# AWS_REGION is set automatically by Elastic Beanstalk / ECS / Lambda.
# AWS_REGION=ap-southeast-1

# Application-level catalog fallback: which iTunes storefront to use when the
# client request carries no country signal (X-User-Country / CF-IPCountry headers).
# Resolved per-request from the user's device locale; this is only the fallback.
DEFAULT_STOREFRONT=in

# Default language for trending / editorial content when no user preference exists.
DEFAULT_LANGUAGE=hindi
