# ── Firebase (required) ───────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# Paste the full service account JSON as a single line (Render env var)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-app.example.com

# ── Keepalive (Render free tier — prevents spin-down) ────────────────────────
KEEPALIVE_URL=https://your-service.onrender.com/healthz
KEEPALIVE_INTERVAL_MS=240000

# ── Push notifications ───────────────────────────────────────────────────────
# Shared secret required in the `x-admin-key` header to call
# POST /api/notifications/new-song (catalog job / cron only — never the client).
ADMIN_NOTIFY_KEY=change-me-to-a-long-random-string

# ── ML service (music-app-backend/ml-service) ────────────────────────────────
# Base URL of the Python ranking service. Leave EMPTY to disable the
# integration entirely — the gateway then ranks with its local heuristics only.
ML_SERVICE_URL=https://your-ml-service.onrender.com
# Must match ML_SERVICE_API_KEY on the ML service.
ML_SERVICE_API_KEY=replace-with-strong-random
# Kill switch: set to false to bypass the ML service without clearing the URL.
ML_ENABLED=true
# Per-request budget. Exceeding it is not an error — the gateway falls back to
# local ranking. Keep the search budget tight; users feel it directly.
ML_TIMEOUT_MS=800
ML_RECOMMENDATION_TIMEOUT_MS=2000

# ── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=hindi
